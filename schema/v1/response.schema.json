{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResponseEnvelope",
  "description": "Versioned serialized response contract.",
  "type": "object",
  "required": [
    "schema_version",
    "value"
  ],
  "properties": {
    "schema_version": {
      "description": "Canonical schema version. Version 1 is currently supported.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "value": {
      "description": "Canonical response.",
      "allOf": [
        {
          "$ref": "#/definitions/UnifiedResponse"
        }
      ]
    }
  },
  "definitions": {
    "Annotation": {
      "description": "A portable response annotation.",
      "oneOf": [
        {
          "description": "A citation into a source.",
          "type": "object",
          "required": [
            "source",
            "type"
          ],
          "properties": {
            "end": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "source": {
              "type": "string"
            },
            "start": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "citation"
              ]
            }
          }
        },
        {
          "description": "A safety classification.",
          "type": "object",
          "required": [
            "blocked",
            "category",
            "type"
          ],
          "properties": {
            "blocked": {
              "type": "boolean"
            },
            "category": {
              "type": "string"
            },
            "probability": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "type": {
              "type": "string",
              "enum": [
                "safety"
              ]
            }
          }
        },
        {
          "description": "A refusal marker.",
          "type": "object",
          "required": [
            "reason",
            "type"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "refusal"
              ]
            }
          }
        }
      ]
    },
    "Candidate": {
      "description": "A model candidate.",
      "type": "object",
      "required": [
        "content",
        "index"
      ],
      "properties": {
        "content": {
          "description": "Ordered output content.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPart"
          }
        },
        "extensions": {
          "description": "Provider-specific candidate data.",
          "type": "object",
          "additionalProperties": true
        },
        "finish_reason": {
          "description": "Why generation ended.",
          "anyOf": [
            {
              "$ref": "#/definitions/FinishReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Optional provider candidate identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "description": "Stable candidate position.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ContentPart": {
      "description": "A typed content item.",
      "oneOf": [
        {
          "description": "Plain text.",
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "properties": {
            "annotations": {
              "description": "Structured annotations associated with the text.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/Annotation"
              }
            },
            "text": {
              "description": "Text content.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            }
          }
        },
        {
          "description": "An image.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "type": {
              "type": "string",
              "enum": [
                "image"
              ]
            }
          }
        },
        {
          "description": "Audio.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "type": {
              "type": "string",
              "enum": [
                "audio"
              ]
            }
          }
        },
        {
          "description": "Video.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "type": {
              "type": "string",
              "enum": [
                "video"
              ]
            }
          }
        },
        {
          "description": "A general file or document.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "filename": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "file"
              ]
            }
          }
        },
        {
          "description": "A model-requested function invocation.",
          "type": "object",
          "required": [
            "call",
            "type"
          ],
          "properties": {
            "call": {
              "$ref": "#/definitions/ToolCall"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_call"
              ]
            }
          }
        },
        {
          "description": "The result of a previous tool invocation.",
          "type": "object",
          "required": [
            "result",
            "type"
          ],
          "properties": {
            "result": {
              "$ref": "#/definitions/ToolResult"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_result"
              ]
            }
          }
        },
        {
          "description": "Model reasoning or thinking content.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "extensions": {
              "type": "object",
              "additionalProperties": true
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "reasoning"
              ]
            }
          }
        },
        {
          "description": "A structured refusal.",
          "type": "object",
          "required": [
            "reason",
            "type"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "refusal"
              ]
            }
          }
        }
      ]
    },
    "EmbedResponse": {
      "description": "A normalized embedding response.",
      "type": "object",
      "required": [
        "embeddings",
        "model"
      ],
      "properties": {
        "embeddings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Embedding"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "model": {
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/Usage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Embedding": {
      "description": "A single embedding vector.",
      "type": "object",
      "required": [
        "index",
        "values"
      ],
      "properties": {
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        }
      }
    },
    "FinishReason": {
      "description": "A normalized finish reason.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "stop"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "length"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tool_call"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "content_filter"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "error"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "raw"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "other"
              ]
            },
            "raw": {
              "type": "string"
            }
          }
        }
      ]
    },
    "GenerateResponse": {
      "description": "A normalized generation response.",
      "type": "object",
      "required": [
        "candidates",
        "model"
      ],
      "properties": {
        "candidates": {
          "description": "Ordered response candidates.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Candidate"
          }
        },
        "extensions": {
          "description": "Provider-specific response fields.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Optional provider response identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "Model reported by the provider.",
          "type": "string"
        },
        "usage": {
          "description": "Provider-reported usage.",
          "anyOf": [
            {
              "$ref": "#/definitions/Usage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ImageResponse": {
      "description": "A normalized image response.",
      "type": "object",
      "required": [
        "images",
        "model"
      ],
      "properties": {
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MediaAsset"
          }
        },
        "model": {
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/Usage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MediaAsset": {
      "description": "A media value used by multimodal inputs and outputs.",
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "extensions": {
          "description": "Provider-specific media metadata.",
          "type": "object",
          "additionalProperties": true
        },
        "height": {
          "description": "Optional pixel height.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "sha256": {
          "description": "Optional SHA-256 digest in lowercase hexadecimal form.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The media payload or reference.",
          "allOf": [
            {
              "$ref": "#/definitions/MediaSource"
            }
          ]
        },
        "width": {
          "description": "Optional pixel width.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "MediaSource": {
      "description": "The backing source of a media asset.",
      "oneOf": [
        {
          "description": "Bytes held directly by the request or response.",
          "type": "object",
          "required": [
            "data",
            "kind",
            "mime_type"
          ],
          "properties": {
            "data": {
              "description": "Raw decoded bytes. Canonical JSON uses base64.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "inline"
              ]
            },
            "mime_type": {
              "description": "IANA media type.",
              "type": "string"
            }
          }
        },
        {
          "description": "A remote URL.",
          "type": "object",
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "url"
              ]
            },
            "mime_type": {
              "description": "Optional IANA media type.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "description": "Absolute media URL.",
              "type": "string"
            }
          }
        },
        {
          "description": "A provider-managed file reference.",
          "type": "object",
          "required": [
            "id",
            "kind",
            "provider"
          ],
          "properties": {
            "id": {
              "description": "Provider file identifier.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "provider_file"
              ]
            },
            "mime_type": {
              "description": "Optional IANA media type.",
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "description": "Provider namespace that owns the file.",
              "type": "string"
            }
          }
        }
      ]
    },
    "ToolCall": {
      "description": "A completed tool call.",
      "type": "object",
      "required": [
        "arguments",
        "id",
        "name"
      ],
      "properties": {
        "arguments": {
          "description": "Completed JSON arguments."
        },
        "extensions": {
          "description": "Provider-specific call data.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Stable call identifier.",
          "type": "string"
        },
        "name": {
          "description": "Function name.",
          "type": "string"
        }
      }
    },
    "ToolResult": {
      "description": "A completed tool result.",
      "type": "object",
      "required": [
        "call_id",
        "content"
      ],
      "properties": {
        "call_id": {
          "description": "Identifier of the matching tool call.",
          "type": "string"
        },
        "content": {
          "description": "Ordered tool result content.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPart"
          }
        },
        "extensions": {
          "description": "Provider-specific result data.",
          "type": "object",
          "additionalProperties": true
        },
        "is_error": {
          "description": "True when the tool invocation failed.",
          "default": false,
          "type": "boolean"
        }
      }
    },
    "UnifiedResponse": {
      "description": "Any normalized response.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "operation",
            "response"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "generate"
              ]
            },
            "response": {
              "$ref": "#/definitions/GenerateResponse"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "operation",
            "response"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "embed"
              ]
            },
            "response": {
              "$ref": "#/definitions/EmbedResponse"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "operation",
            "response"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "image"
              ]
            },
            "response": {
              "$ref": "#/definitions/ImageResponse"
            }
          }
        }
      ]
    },
    "Usage": {
      "description": "Token usage reported by an upstream provider.",
      "type": "object",
      "properties": {
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
