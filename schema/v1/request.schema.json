{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequestEnvelope",
  "description": "Versioned serialized request contract.",
  "type": "object",
  "required": [
    "schema_version",
    "value"
  ],
  "properties": {
    "schema_version": {
      "description": "Canonical schema version. Version 1 is currently supported.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "value": {
      "description": "Canonical request.",
      "allOf": [
        {
          "$ref": "#/definitions/UnifiedRequest"
        }
      ]
    }
  },
  "definitions": {
    "Annotation": {
      "description": "A portable response annotation.",
      "oneOf": [
        {
          "description": "A citation into a source.",
          "type": "object",
          "required": [
            "source",
            "type"
          ],
          "properties": {
            "end": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "source": {
              "type": "string"
            },
            "start": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "citation"
              ]
            }
          }
        },
        {
          "description": "A safety classification.",
          "type": "object",
          "required": [
            "blocked",
            "category",
            "type"
          ],
          "properties": {
            "blocked": {
              "type": "boolean"
            },
            "category": {
              "type": "string"
            },
            "probability": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "type": {
              "type": "string",
              "enum": [
                "safety"
              ]
            }
          }
        },
        {
          "description": "A refusal marker.",
          "type": "object",
          "required": [
            "reason",
            "type"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "refusal"
              ]
            }
          }
        }
      ]
    },
    "ContentPart": {
      "description": "A typed content item.",
      "oneOf": [
        {
          "description": "Plain text.",
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "properties": {
            "annotations": {
              "description": "Structured annotations associated with the text.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/Annotation"
              }
            },
            "text": {
              "description": "Text content.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            }
          }
        },
        {
          "description": "An image.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "type": {
              "type": "string",
              "enum": [
                "image"
              ]
            }
          }
        },
        {
          "description": "Audio.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "type": {
              "type": "string",
              "enum": [
                "audio"
              ]
            }
          }
        },
        {
          "description": "Video.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "type": {
              "type": "string",
              "enum": [
                "video"
              ]
            }
          }
        },
        {
          "description": "A general file or document.",
          "type": "object",
          "required": [
            "asset",
            "type"
          ],
          "properties": {
            "asset": {
              "$ref": "#/definitions/MediaAsset"
            },
            "filename": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "file"
              ]
            }
          }
        },
        {
          "description": "A model-requested function invocation.",
          "type": "object",
          "required": [
            "call",
            "type"
          ],
          "properties": {
            "call": {
              "$ref": "#/definitions/ToolCall"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_call"
              ]
            }
          }
        },
        {
          "description": "The result of a previous tool invocation.",
          "type": "object",
          "required": [
            "result",
            "type"
          ],
          "properties": {
            "result": {
              "$ref": "#/definitions/ToolResult"
            },
            "type": {
              "type": "string",
              "enum": [
                "tool_result"
              ]
            }
          }
        },
        {
          "description": "Model reasoning or thinking content.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "extensions": {
              "type": "object",
              "additionalProperties": true
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "reasoning"
              ]
            }
          }
        },
        {
          "description": "A structured refusal.",
          "type": "object",
          "required": [
            "reason",
            "type"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "refusal"
              ]
            }
          }
        }
      ]
    },
    "EmbedRequest": {
      "description": "A normalized embedding request.",
      "type": "object",
      "required": [
        "inputs",
        "model"
      ],
      "properties": {
        "dimensions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "inputs": {
          "description": "A non-empty ordered list of inputs.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/EmbeddingInput"
          }
        },
        "model": {
          "type": "string"
        },
        "task_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "EmbeddingInput": {
      "description": "Input accepted by the embedding operation.",
      "oneOf": [
        {
          "description": "Plain text.",
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            }
          }
        },
        {
          "description": "Ordered multimodal content.",
          "type": "object",
          "required": [
            "content",
            "type"
          ],
          "properties": {
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ContentPart"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "content"
              ]
            }
          }
        }
      ]
    },
    "GenerateRequest": {
      "description": "A normalized generation request.",
      "type": "object",
      "required": [
        "messages",
        "model"
      ],
      "properties": {
        "extensions": {
          "description": "Provider-specific request fields.",
          "type": "object",
          "additionalProperties": true
        },
        "instructions": {
          "description": "High-priority instructions.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Instruction"
          }
        },
        "messages": {
          "description": "Conversation history and current user input.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Message"
          }
        },
        "model": {
          "description": "Route-facing model name.",
          "type": "string"
        },
        "parameters": {
          "description": "Sampling and output controls.",
          "default": {},
          "allOf": [
            {
              "$ref": "#/definitions/GenerationParameters"
            }
          ]
        },
        "reasoning": {
          "description": "Reasoning controls.",
          "anyOf": [
            {
              "$ref": "#/definitions/ReasoningConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_format": {
          "description": "Structured output preference.",
          "anyOf": [
            {
              "$ref": "#/definitions/ResponseFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "stream": {
          "description": "Whether the caller requested a stream.",
          "default": false,
          "type": "boolean"
        },
        "tool_choice": {
          "description": "Tool selection policy.",
          "anyOf": [
            {
              "$ref": "#/definitions/ToolChoice"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "description": "Available function tools.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolDefinition"
          }
        }
      }
    },
    "GenerationParameters": {
      "description": "Common generation controls.",
      "type": "object",
      "properties": {
        "candidate_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "frequency_penalty": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "logprobs": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "presence_penalty": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "stop_sequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      }
    },
    "ImageRequest": {
      "description": "A normalized image request.",
      "type": "object",
      "required": [
        "model",
        "prompt",
        "task"
      ],
      "properties": {
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "model": {
          "type": "string"
        },
        "negative_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "quality": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream": {
          "default": false,
          "type": "boolean"
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "$ref": "#/definitions/ImageTask"
        }
      }
    },
    "ImageTask": {
      "description": "Image operation details.",
      "oneOf": [
        {
          "description": "Generate images from a prompt.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "generate"
              ]
            }
          }
        },
        {
          "description": "Edit an input image, optionally under a mask.",
          "type": "object",
          "required": [
            "image",
            "type"
          ],
          "properties": {
            "image": {
              "$ref": "#/definitions/MediaAsset"
            },
            "mask": {
              "anyOf": [
                {
                  "$ref": "#/definitions/MediaAsset"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "edit"
              ]
            }
          }
        },
        {
          "description": "Produce variations of an input image.",
          "type": "object",
          "required": [
            "image",
            "type"
          ],
          "properties": {
            "image": {
              "$ref": "#/definitions/MediaAsset"
            },
            "type": {
              "type": "string",
              "enum": [
                "variation"
              ]
            }
          }
        }
      ]
    },
    "Instruction": {
      "description": "A high-priority instruction kept separate from conversation messages.",
      "type": "object",
      "required": [
        "content",
        "kind"
      ],
      "properties": {
        "content": {
          "description": "Ordered multimodal content.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPart"
          }
        },
        "extensions": {
          "description": "Provider-specific instruction data.",
          "type": "object",
          "additionalProperties": true
        },
        "kind": {
          "description": "Instruction class.",
          "allOf": [
            {
              "$ref": "#/definitions/InstructionKind"
            }
          ]
        },
        "priority": {
          "description": "Lower values indicate higher priority.",
          "default": 0,
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "InstructionKind": {
      "description": "The kind of high-priority instruction.",
      "oneOf": [
        {
          "description": "A system-level instruction.",
          "type": "string",
          "enum": [
            "system"
          ]
        },
        {
          "description": "A developer-level instruction.",
          "type": "string",
          "enum": [
            "developer"
          ]
        }
      ]
    },
    "MediaAsset": {
      "description": "A media value used by multimodal inputs and outputs.",
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "extensions": {
          "description": "Provider-specific media metadata.",
          "type": "object",
          "additionalProperties": true
        },
        "height": {
          "description": "Optional pixel height.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "sha256": {
          "description": "Optional SHA-256 digest in lowercase hexadecimal form.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The media payload or reference.",
          "allOf": [
            {
              "$ref": "#/definitions/MediaSource"
            }
          ]
        },
        "width": {
          "description": "Optional pixel width.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "MediaSource": {
      "description": "The backing source of a media asset.",
      "oneOf": [
        {
          "description": "Bytes held directly by the request or response.",
          "type": "object",
          "required": [
            "data",
            "kind",
            "mime_type"
          ],
          "properties": {
            "data": {
              "description": "Raw decoded bytes. Canonical JSON uses base64.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "inline"
              ]
            },
            "mime_type": {
              "description": "IANA media type.",
              "type": "string"
            }
          }
        },
        {
          "description": "A remote URL.",
          "type": "object",
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "url"
              ]
            },
            "mime_type": {
              "description": "Optional IANA media type.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "description": "Absolute media URL.",
              "type": "string"
            }
          }
        },
        {
          "description": "A provider-managed file reference.",
          "type": "object",
          "required": [
            "id",
            "kind",
            "provider"
          ],
          "properties": {
            "id": {
              "description": "Provider file identifier.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "provider_file"
              ]
            },
            "mime_type": {
              "description": "Optional IANA media type.",
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "description": "Provider namespace that owns the file.",
              "type": "string"
            }
          }
        }
      ]
    },
    "Message": {
      "description": "A conversation message.",
      "type": "object",
      "required": [
        "content",
        "role"
      ],
      "properties": {
        "content": {
          "description": "Ordered message content.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPart"
          }
        },
        "extensions": {
          "description": "Provider-specific message data.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Optional stable provider message identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Message author.",
          "allOf": [
            {
              "$ref": "#/definitions/Role"
            }
          ]
        }
      }
    },
    "ReasoningConfig": {
      "description": "Common reasoning controls.",
      "type": "object",
      "properties": {
        "budget_tokens": {
          "description": "Requested reasoning token budget.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "effort": {
          "description": "Provider-neutral effort label such as low, medium, or high.",
          "type": [
            "string",
            "null"
          ]
        },
        "include_summary": {
          "description": "Whether a human-readable summary is requested.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ResponseFormat": {
      "description": "Structured output preference.",
      "oneOf": [
        {
          "description": "Unconstrained text.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            }
          }
        },
        {
          "description": "Any JSON object.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json_object"
              ]
            }
          }
        },
        {
          "description": "JSON constrained by a named JSON Schema.",
          "type": "object",
          "required": [
            "name",
            "schema",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "schema": true,
            "strict": {
              "default": false,
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "json_schema"
              ]
            }
          }
        }
      ]
    },
    "Role": {
      "description": "A message author role.",
      "oneOf": [
        {
          "description": "End-user content.",
          "type": "string",
          "enum": [
            "user"
          ]
        },
        {
          "description": "Model-generated content.",
          "type": "string",
          "enum": [
            "assistant"
          ]
        },
        {
          "description": "A tool result message.",
          "type": "string",
          "enum": [
            "tool"
          ]
        }
      ]
    },
    "ToolCall": {
      "description": "A completed tool call.",
      "type": "object",
      "required": [
        "arguments",
        "id",
        "name"
      ],
      "properties": {
        "arguments": {
          "description": "Completed JSON arguments."
        },
        "extensions": {
          "description": "Provider-specific call data.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Stable call identifier.",
          "type": "string"
        },
        "name": {
          "description": "Function name.",
          "type": "string"
        }
      }
    },
    "ToolChoice": {
      "description": "Tool selection policy.",
      "oneOf": [
        {
          "description": "The provider chooses whether to call a tool.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          }
        },
        {
          "description": "The model must not call a tool.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "description": "The model must call at least one tool.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "required"
              ]
            }
          }
        },
        {
          "description": "The model must call a named function.",
          "type": "object",
          "required": [
            "name",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "function"
              ]
            }
          }
        }
      ]
    },
    "ToolDefinition": {
      "description": "A portable function declaration.",
      "type": "object",
      "required": [
        "input_schema",
        "name"
      ],
      "properties": {
        "description": {
          "description": "Optional function description.",
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "description": "Provider-specific tool data.",
          "type": "object",
          "additionalProperties": true
        },
        "input_schema": {
          "description": "JSON Schema accepted by the function."
        },
        "name": {
          "description": "Function name.",
          "type": "string"
        }
      }
    },
    "ToolResult": {
      "description": "A completed tool result.",
      "type": "object",
      "required": [
        "call_id",
        "content"
      ],
      "properties": {
        "call_id": {
          "description": "Identifier of the matching tool call.",
          "type": "string"
        },
        "content": {
          "description": "Ordered tool result content.",
          "type": "array",
          "items": {
